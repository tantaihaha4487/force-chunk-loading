{
  "schemaVersion": 1,
  "id": "force_chunk_loading",
  "version": "${version}",

  "name": "Force Chunk Loading",
  "description": "A server-authoritative, craftable configurable-texture player head that keeps its chunk loaded.",
  "authors": ["Thanachot"],
  "contact": {},

  "license": "MIT",

  "environment": "*",
  "mixins": [
    "force_chunk_loading.mixins.json"
  ],
  "entrypoints": {
    "main": [
      "com.tantaihaha.forcechunkloading.force_chunk_loading.ForceChunkLoading"
    ],
    "client": [
      "com.tantaihaha.forcechunkloading.force_chunk_loading.ForceChunkLoadingClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "java": ">=25",
    "fabric-api": "*",

    "minecraft": "~${minecraft_version}"
  }
}
